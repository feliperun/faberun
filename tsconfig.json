{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2023"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noUnusedLocals": true
  },
  "include": [".claude/hooks/**/*.mjs", "src/**/*.mjs", "test/**/*.mjs", "bin/**/*.mjs", "evals/**/*.mjs"]
}
